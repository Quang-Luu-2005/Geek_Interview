{
  "name": "ticket-booking-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Concert ticket booking backend technical assessment",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,scripts,tests}/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"{src,scripts,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,scripts,tests}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.ts --runInBand",
    "test:unit": "jest --config jest.config.ts --runInBand tests/unit",
    "test:integration": "jest --config jest.config.integration.ts --runInBand",
    "test:concurrency": "jest --config jest.config.concurrency.ts --runInBand --passWithNoTests",
    "test:load": "node scripts/check-load-test.mjs",
    "verify:submission": "node scripts/verify-submission.mjs",
    "verify:delivery": "node scripts/verify-delivery.mjs",
    "demo:smoke": "node scripts/reviewer-smoke.mjs",
    "demo:wow": "node scripts/reviewer-wow.mjs",
    "prisma:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run verify:submission",
    "prepare": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.1",
    "joi": "^18.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
