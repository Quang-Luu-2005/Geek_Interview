flowchart TB
    subgraph customerLane[Customer Use Cases]
        direction LR
        customer[Customer]
        browse([Browse concerts])
        availability([View categories<br/>and availability])
        create([Create booking])
        voucher([Apply voucher])
        ownBookings([View booking<br/>status/history])
        confirm([Confirm reservation])
        cancel([Cancel reservation])
        customer --> browse & availability & create & voucher
        customer --> ownBookings & confirm & cancel
    end

    subgraph operationLane[Operation Use Cases]
        direction LR
        operator[Operator]
        administrator[Administrator]
        monitor([Monitor bookings])
        inspect([Inspect booking])
        changeStatus([Change booking status])
        configureConcert([Create concert/category])
        publishConcert([Publish concert])
        configureVoucher([Create voucher])
        operator --> monitor & inspect & changeStatus
        administrator --> monitor & inspect & changeStatus
        administrator --> configureConcert & publishConcert & configureVoucher
    end

    subgraph workerLane[Automated Use Case]
        direction LR
        worker[System Worker] --> expire([Expire reservations])
    end

    classDef actor fill:#ffffff,stroke:#111827,stroke-width:2px;
    classDef customerUseCase fill:#e8f3ff,stroke:#2563eb,stroke-width:1px;
    classDef operationUseCase fill:#f0fdf4,stroke:#15803d,stroke-width:1px;
    classDef automatedUseCase fill:#fff7ed,stroke:#c2410c,stroke-width:1px;
    class customer,operator,administrator,worker actor;
    class browse,availability,create,voucher,ownBookings,confirm,cancel customerUseCase;
    class monitor,inspect,changeStatus,configureConcert,publishConcert,configureVoucher operationUseCase;
    class expire automatedUseCase;
