{
  "info": {
    "name": "Ticket Booking - Customer APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "customerUserId", "value": "" },
    { "key": "concertId", "value": "summer-festival-2026" },
    { "key": "bookingId", "value": "" },
    { "key": "standardCategoryId", "value": "" },
    { "key": "idempotencyKey", "value": "checkout-example-001" }
  ],
  "item": [
    {
      "name": "Browse published concerts",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/concerts?page=1&limit=20" }
    },
    {
      "name": "Concert detail",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/concerts/{{concertId}}" }
    },
    {
      "name": "Ticket categories and availability",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/concerts/{{concertId}}/ticket-categories" }
    },
    {
      "name": "Current user's booking history",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-user-id", "value": "{{customerUserId}}" }],
        "url": "{{baseUrl}}/api/me/bookings?page=1&limit=20"
      }
    },
    {
      "name": "Owned booking detail",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-user-id", "value": "{{customerUserId}}" }],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
      }
    },
    {
      "name": "Create booking",
      "request": {
        "method": "POST",
        "header": [
          { "key": "content-type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{customerUserId}}" },
          { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"concertId\": \"{{concertId}}\",\n  \"items\": [{ \"ticketCategoryId\": \"{{standardCategoryId}}\", \"quantity\": 1 }]\n}"
        },
        "url": "{{baseUrl}}/api/bookings"
      }
    }
  ]
}
